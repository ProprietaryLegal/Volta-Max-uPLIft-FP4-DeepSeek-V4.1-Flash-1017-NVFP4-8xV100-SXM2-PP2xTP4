+# NVFP4-8R P4 arm 2: the checkpoint's MXFP4 Engram table in the reader's
+# 144-byte row (128 code bytes | 8 E8M0 scales | 8 zero bytes), dequantized on
+# the GPU. Same row size as IQ4_NL, so the node reader and shared buffers are
+# unchanged; only the table file and the row decoder differ.
+MXFP4_ROW_BYTES = 144
+_E2M1 = (0.0, 0.5, 1.0, 1.5, 2.0, 3.0, 4.0, 6.0)
+_mxfp4_lut: dict[torch.device, torch.Tensor] = {}
+
+
+def _decode_rows(raw: torch.Tensor, codec: str) -> torch.Tensor:
+    if codec == "mxfp4":
+        return dequantize_mxfp4_rows(raw, torch.float16)
+    if codec == "iq4_nl":
+        from .quantization.gguf import dequantize_gguf_rows
+
+        return dequantize_gguf_rows(raw, 20, 256, torch.float16, True)
+    raise ValueError(f"unknown Engram row codec {codec!r}")
+
+
+def pack_mxfp4_rows(codes: torch.Tensor, scales: torch.Tensor) -> torch.Tensor:
+    """Checkpoint rows (codes [N, 128] u8, E8M0 scales [N, 8] u8) -> [N, 144]."""
+    if (
+        codes.dtype != torch.uint8
+        or scales.dtype != torch.uint8
+        or codes.ndim != 2
+        or codes.shape[1] != 128
+        or scales.shape != (codes.shape[0], 8)
+    ):
+        raise ValueError("MXFP4 Engram rows need u8 codes [N, 128] and scales [N, 8]")
+    if bool((scales == 255).any()):
+        raise ValueError("E8M0 NaN scale in MXFP4 Engram rows")
+    out = torch.zeros(
+        (codes.shape[0], MXFP4_ROW_BYTES), dtype=torch.uint8, device=codes.device
+    )
+    out[:, :128] = codes
+    out[:, 128:136] = scales
+    return out
+
+
+def dequantize_mxfp4_rows(raw: torch.Tensor, dtype: torch.dtype) -> torch.Tensor:
+    """[N, 144] packed rows -> [N, 256]: e2m1(nibble) x 2^(s - 127), the low
+    nibble holding the even element. Exact in fp32, rounded once to dtype.
+    Graph-capturable (no host sync)."""
+    if raw.dtype != torch.uint8 or raw.ndim != 2 or raw.shape[1] != MXFP4_ROW_BYTES:
+        raise ValueError("MXFP4 Engram rows must be uint8 [N, 144]")
+    lut = _mxfp4_lut.get(raw.device)
+    if lut is None:
+        lut = torch.tensor(
+            _E2M1 + tuple(-v for v in _E2M1), dtype=torch.float32, device=raw.device
+        )
+        _mxfp4_lut[raw.device] = lut
+    n = raw.shape[0]
+    codes = raw[:, :128]
+    nib = torch.stack((codes & 15, codes >> 4), dim=-1).view(n, 256)
+    values = lut[nib.long()]
+    # 2^(s - 127) built from the fp32 exponent bits: exact for s in 1..254.
+    block = (raw[:, 128:136].to(torch.int32) << 23).view(torch.float32)
+    return (values.view(n, 8, 32) * block[:, :, None]).view(n, 256).to(dtype)

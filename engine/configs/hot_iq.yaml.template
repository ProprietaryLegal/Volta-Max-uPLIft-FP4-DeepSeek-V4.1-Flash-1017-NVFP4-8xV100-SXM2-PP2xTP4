# hot_iq serving profile of this package (PP2 x TP4 on 8x V100-SXM2-32GB).
# Replace ${PKG} with the absolute path of the downloaded package, then start the server with the
# launcher of the GitHub repository (it sets the engine environment). Every value except the paths,
# the port and the tier map key is the profile the published measurements were taken with.
model: ${PKG}/gguf/DeepSeek-V4.1-Flash-1017-GSQ-RCO-IQ2_XXS-00001-of-00004.gguf
hf-config-path: ${PKG}/base
tokenizer: ${PKG}/base
tokenizer-mode: deepseek_v41
served-model-name: deepseek-v4.1-flash
host: 127.0.0.1
port: 8000
dtype: half
quantization: gguf
load-format: gguf
tensor-parallel-size: 4
pipeline-parallel-size: 2
max-model-len: 524288
max-num-seqs: 1
max-num-batched-tokens: 8192
kv-cache-memory-bytes: 268435456
gpu-memory-utilization: 0.96
no-enforce-eager: true
compilation-config:
  mode: 0
  cudagraph_mode: FULL
  cudagraph_capture_sizes: [1, 2, 3, 4, 5, 6]
  max_cudagraph_capture_size: 6
no-async-scheduling: true
enable-prefix-caching: true
enable-chunked-prefill: true
no-disable-custom-all-reduce: true
enable-auto-tool-choice: true
tool-call-parser: deepseek_v41
reasoning-parser: deepseek_v4
default-chat-template-kwargs: '{"thinking": true}'
model-loader-extra-config:
  engram_path: ${PKG}/engram/DeepSeek-V4.1-Flash-Engram-IQ4_NL.gguf
  nvfp4_8r_packs: ${PKG}/experts-mxfp4
  nvfp4_8r_tier_map: ${PKG}/tier_map.json
  nvfp4_8r_reserve_bytes: {'0': 4831838208, '20': 8053063680}
  nvfp4_8r_residency: hot_iq
  nvfp4_8r_prefill_warm: native_staged
speculative-config:
  method: dspark
  model: ${PKG}/dspark
  quantization: fp8
  num_speculative_tokens: 5
  draft_load_config: {load_format: safetensors}
  enforce_eager: false
kernel-config:
  sm70_ring: {enabled: false}
  sm70_gguf: {expert_storage: original, expert_arena: true, expert_cache_host_storage: shared_original, expert_cache_offload_fraction: 0,
    expert_cache_spare_slots: 0, expert_cache_fraction: 0, expert_cache_host_slack: 0, expert_load_prefetch_banks: 1,
    expert_cache_prefill_tokens: 4096, dense_storage: original, embedding_storage: original, prefill_min_m: 1, dequant_workspace_bytes: 33554432}
